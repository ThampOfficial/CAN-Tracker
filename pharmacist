<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box}body{margin:0;padding:0;font:14px system-ui,sans-serif;background:#EEF1F4;color:#14213D}</style></head><body>
<title>Canadian Pharmacist Licensing Progress Tracker</title>
<style>
:root {
  --bg: #EEF1F4; --surface: #FFFFFF; --surface2: #E6EBF0; --ink: #14213D;
  --muted: #5A6678; --line: #CFD7E0; --accent: #0B6E6A; --accent-ink: #FFFFFF;
  --warn: #8A5200; --warn-bg: #FBEFD5; --bad: #B3261E; --bad-bg: #FBE4E1; --ok: #17703F; --ok-bg: #DDF2E6;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink); font-family: system-ui, -apple-system, sans-serif; font-size: 15px; line-height: 1.55;
  padding: 20px 16px 56px;
}
.wrap { max-width: 1120px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
h1, h2, h3 { margin: 0; line-height: 1.2; }
h1 { font-size: 26px; font-weight: 700; }
h2 { font-size: 18px; font-weight: 600; }
h3 { font-size: 15px; font-weight: 600; }
.sub { color: var(--muted); font-size: 13px; margin: 2px 0 0; }
.mono { font-variant-numeric: tabular-nums; font-family: monospace; }
.label { font-size: 12px; letter-spacing: .04em; color: var(--muted); font-weight: 500; }

header.top { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; }
.nav-switch { display: flex; gap: 8px; }
.nav-link {
  font-weight: 600; text-decoration: none; padding: 8px 16px; border-radius: 6px; border: 1px solid var(--line);
  background: var(--surface); color: var(--ink); font-size: 14px;
}
.nav-link.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

.notice { background: #E0F2FE; color: #0369A1; border-radius: 6px; padding: 10px 14px; font-size: 13px; border: 1px solid #BAE6FD; }
.grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 16px; align-items: start; }
@media (max-width: 880px) { .grid { grid-template-columns: minmax(0, 1fr); } }
.col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 16px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.card-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }

.row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
.field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
input[type=text], input[type=number], input[type=date], select, textarea {
  font: inherit; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 6px;
  padding: 8px 10px; min-height: 40px; width: 100%; min-width: 0;
}
textarea { min-height: 64px; resize: vertical; }

.btn {
  font: inherit; font-weight: 600; cursor: pointer; border-radius: 6px; padding: 8px 14px; min-height: 40px;
  border: 1px solid var(--line); background: var(--surface); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; gap: 6px;
}
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn.ghost { border-color: transparent; color: var(--muted); }
.btn.small { min-height: 36px; padding: 6px 12px; font-size: 13px; width: 100%; }

.stage-stamp {
  display: inline-block; font-family: monospace; font-size: 12px; letter-spacing: .03em; text-transform: uppercase;
  border: 1.5px solid var(--accent); color: var(--accent); padding: 2px 8px; border-radius: 3px;
}
.pred { display: flex; flex-direction: column; gap: 10px; border-top: 1px dashed var(--line); padding-top: 12px; }

.steps { display: flex; flex-wrap: wrap; gap: 3px; margin: 0; padding: 0; list-style: none; }
.steps li { flex: 1 1 0; min-width: 14px; height: 6px; border-radius: 3px; background: var(--surface2); }
.steps li.done { background: var(--accent); }
.steps li.now { background: var(--accent); opacity: .5; }

.timeline-box { margin-top: 4px; border-left: 2px solid var(--accent); padding-left: 12px; display: flex; flex-direction: column; gap: 8px; }
.timeline-item { font-size: 13px; display: flex; justify-content: space-between; align-items: center; background: var(--surface2); padding: 8px 10px; border-radius: 4px; gap: 8px; flex-wrap: wrap; }
.timeline-item input[type=date] { width: 130px; min-height: 32px; font-size: 12px; padding: 2px 6px; }

.foot { color: var(--muted); font-size: 12px; }
</style>

<div id="app" class="wrap">
  <header class="top">
    <div>
      <h1>Canadian Pharmacist Licensing Tracker</h1>
      <p class="sub">ติดตามขั้นตอนการขอใบอนุญาตประกอบวิชาชีพเภสัชกรในแคนาดา (BC -> Toronto Path)</p>
    </div>
    <nav class="nav-switch">
      <a href="index.html" class="nav-link">🇨🇦 IRCC PR Tracker</a>
      <a href="pharmacist.html" class="nav-link active">💊 Pharmacist Licensing</a>
    </nav>
  </header>

  <div class="notice">
    <b>💊 เส้นทางแผนปัจจุบัน (BC -> Toronto):</b> สอบ PEBC (EE, MCQ, IELTS, OSCE) ให้เรียบร้อยใน BC แล้วย้ายไปลงทะเบียน OCP, สอบกฎหมาย Toronto (JE), ฝึกงาน (SPT) และอบรมใบวัคซีน
  </div>

  <div class="grid">
    <div class="col" id="main-track"></div>
    <div class="col">
      <section class="card">
        <h2>📌 ลำดับแผนงาน (BC -> Toronto)</h2>
        <p class="sub">สรุปสเต็ปสำคัญตามแผนของคุณ</p>
        <ol style="padding-left: 20px; margin: 0; font-size: 13px; display: flex; flex-direction: column; gap: 8px;">
          <li><b>PEBC Document Evaluation & EE</b> (ใน BC)</li>
          <li><b>PEBC Qualifying Part I (MCQ)</b> (ทำงาน Pharmacy Assistant ใน BC ควบคู่ได้)</li>
          <li><b>Language Proficiency (IELTS/CELPIP)</b> (สอบหลัง MCQ)</li>
          <li><b>PEBC Qualifying Part II (OSCE)</b> (สอบใน BC ให้เรียบร้อย)</li>
          <li><b>ย้ายไป Toronto & Register OCP</b> (ลงทะเบียนสภาจังหวัด Ontario)</li>
          <li><b>Jurisprudence Exam (JE - Toronto)</b> (สอบกฎหมายมณฑล Ontario)</li>
          <li><b>Structured Practical Training (SPT)</b> (เก็บชั่วโมงฝึกงานใน Ontario)</li>
          <li><b>Injection Certification</b> (อบรมและสอบใบอนุญาตฉีดวัคซีน)</li>
          <li><b>Full Licensure (RPh)</b> (รับใบอนุญาตเภสัชกรเต็มตัว)</li>
        </ol>
      </section>
    </div>
  </div>
  <p class="foot">บันทึกข้อมูลอัตโนมัติในเบราว์เซอร์แล้ว</p>
</div>

<script>
const PHARM_STAGES = [
  { label: '1. Document Evaluation (ประเมินวุฒิกับ PEBC)', win: [60, 120], hint: 'ยื่นเอกสารประเมินปริญญาเภสัชศาสตร์กับ PEBC' },
  { label: '2. PEBC Evaluating Examination (EE)', win: [90, 180], hint: 'สอบประเมินความรู้พื้นฐานทางเภสัชศาสตร์' },
  { label: '3. PEBC Qualifying Examination Part I (MCQ)', win: [90, 180], hint: 'สอบข้อเขียน (ในระหว่างนี้ทำงานเป็น Pharmacy Assistant/Student ใน BC ได้)' },
  { label: '4. Language Proficiency Test (สอบภาษา IELTS/CELPIP)', win: [30, 90], hint: 'สอบภาษาอังกฤษหลังผ่าน MCQ ตามแผนที่วางไว้' },
  { label: '5. PEBC Qualifying Examination Part II (OSCE)', win: [90, 180], hint: 'สอบปฏิบัติ OSCE ใน BC ให้เรียบร้อยก่อนย้ายมณฑล' },
  { label: '6. Provincial Registration (ย้ายไป Toronto & ลงทะเบียน OCP)', win: [14, 45], hint: 'ย้ายไปโตรอนโต้ และลงทะเบียนเป็น Pre-registrant กับ OCP (Ontario College of Pharmacists)' },
  { label: '7. Pharmacy Jurisprudence Examination (JE - Toronto)', win: [30, 60], hint: 'สอบกฎหมายและจริยธรรมเภสัชกรรมมณฑล Ontario' },
  { label: '8. Structured Practical Training (SPT / Internship - Toronto)', win: [90, 180], hint: 'เก็บชั่วโมงฝึกงานใน Ontario ตามเกณฑ์ที่ OCP กำหนด' },
  { label: '9. Injection Certification (อบรมและสอบใบฉีดวัคซีน)', win: [14, 30], hint: 'ผ่านหลักสูตรอบรมการฉีดวัคซีนและยาฉีดตามเกณฑ์ OCP' },
  { label: '10. Final Licensure & Registration (ใบอนุญาตเภสัชกรเต็มตัว)', win: [14, 30], final: true, hint: 'ขึ้นทะเบียนเป็น Registered Pharmacist (RPh) เต็มตัวใน Ontario' }
];

const STORE_KEY = 'pharm-tracker-v2';
const DAY = 86400000;

function parseD(s) { if (!s) return todayD(); const [y, m, d] = String(s).split('-').map(Number); return new Date(y, m - 1, d); }
function fmtISO(d) { const p = (n) => String(n).padStart(2, '0'); return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()); }
function todayD() { const n = new Date(); return new Date(n.getFullYear(), n.getMonth(), n.getDate()); }
function addDays(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }
function fmtSpan(a, b) {
  const y = a.getFullYear() === b.getFullYear();
  const f = (d, withY) => d.toLocaleDateString('th-TH-u-ca-gregory', withY ? { day: 'numeric', month: 'short', year: 'numeric' } : { day: 'numeric', month: 'short' });
  return f(a, !y) + ' – ' + f(b, true);
}
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
function opt(v, label, sel) { return '<option value="' + esc(v) + '"' + (String(sel) === String(v) ? ' selected' : '') + '>' + esc(label) + '</option>'; }

function readState() {
  try {
    const raw = localStorage.getItem(STORE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return { stage: 0, date: fmtISO(todayD()), note: '', history: [{ stage: 0, date: fmtISO(todayD()) }] };
}

function writeState(s) {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(s)); } catch (e) {}
}

let state = readState();

function render() {
  const idx = Math.min(Math.max(state.stage, 0), PHARM_STAGES.length - 1);
  const curStage = PHARM_STAGES[idx];

  const dots = PHARM_STAGES.map((s, i) => '<li class="' + (i < idx ? 'done' : i === idx ? 'now' : '') + '" title="' + esc(s.label) + '"></li>').join('');

  // กรองและเรียงประวัติ
  const seen = new Set();
  const sortedHist = [...(state.history || [])].sort((a, b) => a.stage - b.stage);
  const historyItems = [];
  sortedHist.forEach(h => {
    if (!seen.has(h.stage)) {
      seen.add(h.stage);
      historyItems.push(h);
    }
  });
  state.history = historyItems;

  const historyHtml = historyItems.map(h => {
    const stName = PHARM_STAGES[h.stage] ? PHARM_STAGES[h.stage].label : 'ขั้นตอนที่ ' + h.stage;
    return '<div class="timeline-item"><span>✅ <b>' + esc(stName) + '</b></span>' +
      '<div style="display:flex;gap:6px;align-items:center;">' +
      '<input type="date" data-act="edit-date" data-stage="' + h.stage + '" value="' + esc(h.date) + '">' +
      '<button class="btn ghost small" style="min-height:32px;width:32px;padding:0;" data-act="del-history" data-stage="' + h.stage + '" title="ลบ">🗑️</button>' +
      '</div></div>';
  }).join('');

  // คำนวณ Predict Timeline
  let remainingHtml = '';
  let accumMin = 0;
  let accumMax = 0;
  const baseDate = parseD(state.date || fmtISO(todayD()));

  for (let i = idx + 1; i < PHARM_STAGES.length; i++) {
    const stObj = PHARM_STAGES[i];
    const w = stObj.win || [30, 60];
    accumMin += w[0];
    accumMax += w[1];

    const predFrom = addDays(baseDate, accumMin);
    const predTo = addDays(baseDate, accumMax);
    const dateStr = fmtSpan(predFrom, predTo);

    remainingHtml += '<div class="timeline-item" style="opacity:0.9; border-left:3px solid var(--accent);">' +
      '<span>⏳ <b>' + esc(stObj.label) + '</b></span>' +
      '<span class="mono" style="font-size:12px;background:var(--surface);padding:3px 8px;border-radius:4px;border:1px solid var(--line);color:var(--accent);font-weight:600;">คาดว่า: ' + dateStr + '</span>' +
      '</div>';
  }

  const mainHtml = '<section class="card">' +
    '<div class="card-head"><h2>ติดตามความคืบหน้า (Pharmacist Path)</h2><span class="stage-stamp">BC -> TORONTO PATH</span></div>' +
    '<div class="row">' +
      '<div class="field" style="grid-column: span 2;"><label class="label">ขั้นตอนปัจจุบัน (' + (idx + 1) + '/' + PHARM_STAGES.length + ')</label><select id="stage-select">' + PHARM_STAGES.map((s, i) => opt(i, s.label, idx)).join('') + '</select></div>' +
      '<div class="field"><label class="label">วันที่อัปเดตสถานะนี้</label><input type="date" id="date-input" value="' + esc(state.date) + '"></div>' +
    '</div>' +
    '<ol class="steps">' + dots + '</ol>' +
    '<div class="pred"><div><b>คำแนะนำขั้นตอนปัจจุบัน:</b> ' + esc(curStage.hint || '-') + '</div></div>' +
    '<button class="btn primary small" id="btn-complete">✅ ทำขั้นตอนนี้เรียบร้อยแล้ว (เลื่อนไปขั้นถัดไปและบันทึก)</button>' +
    '<div class="field"><label class="label">บันทึกเพิ่มเติม</label><textarea id="note-input">' + esc(state.note) + '</textarea></div>' +
    '<h3>ไทม์ไลน์ความคืบหน้าที่ทำสำเร็จแล้ว (แก้ไขวันที่/ลบได้)</h3>' +
    '<div class="timeline-box">' + (historyHtml || '<div class="sub">ยังไม่มีประวัติการทำสำเร็จ</div>') + '</div>' +
    '<h3>Predict Timeline (ขั้นตอนที่เหลือ พร้อมวันที่คาดการณ์)</h3>' +
    '<div class="timeline-box" style="border-left-color: var(--accent);">' + (remainingHtml || '<div class="sub">ถึงขั้นตอนสุดท้ายแล้ว</div>') + '</div>' +
    '</section>';

  document.getElementById('main-track').innerHTML = mainHtml;
}

document.addEventListener('change', (e) => {
  const el = e.target;
  if (el.id === 'stage-select') {
    state.stage = Number(el.value);
    state.date = fmtISO(todayD());
    state.history.push({ stage: state.stage, date: state.date });
    writeState(state);
    render();
  }
  else if (el.id === 'date-input') {
    state.date = el.value;
    if (state.history.length) state.history[state.history.length - 1].date = state.date;
    writeState(state);
    render();
  }
  else if (el.dataset.act === 'edit-date') {
    const stNum = Number(el.dataset.stage);
    const h = state.history.find(x => x.stage === stNum);
    if (h) { h.date = el.value; writeState(state); render(); }
  }
});

document.addEventListener('input', (e) => {
  if (e.target.id === 'note-input') { state.note = e.target.value; writeState(state); }
});

document.addEventListener('click', (e) => {
  const b = e.target.closest('[data-act], #btn-complete');
  if (!b) return;
  if (b.id === 'btn-complete') {
    const curIdx = state.stage;
    const curDate = state.date || fmtISO(todayD());
    const existing = state.history.find(h => h.stage === curIdx);
    if (!existing) state.history.push({ stage: curIdx, date: curDate });
    else existing.date = curDate;

    if (curIdx < PHARM_STAGES.length - 1) {
      state.stage = curIdx + 1;
      state.date = fmtISO(todayD());
    }
    writeState(state);
    render();
  } else if (b.dataset.act === 'del-history') {
    const stNum = Number(b.dataset.stage);
    state.history = state.history.filter(x => x.stage !== stNum);
    writeState(state);
    render();
  }
});

render();
</script>
</body></html>
